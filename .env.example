# Copy to .env and fill in what you have. Every key is optional: with none of them the app runs in demo mode.
# .env is read by docker compose and by the pytest suite. For `bun run dev`, export the values in your shell
# (or run uvicorn through a tool that loads .env).

# ---- Operator console ----
# Token for every /api route. Blank = a random token on each start, logged as an "Operator console" link.
DISPUTESHIELD_OPERATOR_TOKEN=
# Demo mode: simulated chargebacks, unsigned webhooks, nothing is sent to PayPal. `docker compose up` and
# `bun run dev` turn it on by themselves; the bare app has it off.
# DISPUTESHIELD_DEMO_MODE=1
# Port in the "Operator console" link (default 8000). With compose, set HOST_PORT to move the published port.
# PORT=8000
# HOST_PORT=8000
# SQLite file (default data/disputeshield.db).
# DISPUTESHIELD_DB=data/disputeshield.db

# ---- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox only: the app refuses any other host. Default is https://api-m.sandbox.paypal.com
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Id of the webhook you add to the sandbox app (Webhooks > Add webhook). Set = signatures are verified with PayPal.
PAYPAL_WEBHOOK_ID=

# ---- AI ----
# ollama (default) | claude | off. claude needs ANTHROPIC_API_KEY, otherwise the app uses regex and templates.
# DISPUTESHIELD_LLM=ollama
# Ollama server (default http://localhost:11434) and model (default qwen3:8b).
# OLLAMA_HOST=http://localhost:11434
# DISPUTESHIELD_OLLAMA_MODEL=qwen3:8b
ANTHROPIC_API_KEY=
# Claude model id when DISPUTESHIELD_LLM=claude (default claude-sonnet-5-5).
# DISPUTESHIELD_CLAUDE_MODEL=claude-sonnet-5-5

# ---- Test runs only ----
# E2E_PORT=8765
# E2E_BASE_URL=http://127.0.0.1:8777
